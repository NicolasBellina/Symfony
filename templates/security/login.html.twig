{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <h1>Connexion</h1>

    {% if error %}
        <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form action="{{ path('app_login') }}" method="post">
        <label for="username">Email</label>
        <input type="email" id="username" name="_username" value="{{ last_username }}" required autocomplete="email">

        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="_password" required autocomplete="current-password">

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Se connecter</button>
    </form>

    <p>Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
{% endblock %}

