{% extends 'base.html.twig' %}

{% block title %}Inscription — Symphony{% endblock %}

{% block body %}
    <div class="card card-auth">
        <div class="page-header page-header--center">
            <h1>Rejoindre Symphony</h1>
            <p>Créez votre compte en quelques secondes.</p>
        </div>

        {{ form_start(registrationForm, { attr: { class: 'auth-form' } }) }}
            {{ form_row(registrationForm.email, { attr: { placeholder: 'vous@exemple.com' } }) }}
            {{ form_row(registrationForm.plainPassword.first, { label: 'Mot de passe' }) }}
            {{ form_row(registrationForm.plainPassword.second, { label: 'Confirmer le mot de passe' }) }}
            {{ form_row(registrationForm.save) }}
        {{ form_end(registrationForm) }}

        <p class="auth-footer">
            Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
        </p>
    </div>
{% endblock %}
