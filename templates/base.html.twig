<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Symphony Mini-Projet{% endblock %}</title>
        <link rel="stylesheet" href="/assets/css/app.css">
    </head>
    <body>
        <header>
            <img src="/assets/images/logo.svg" alt="Logo" height="48">
            <nav>
                <a href="{{ path('home') }}">Accueil</a>
                <a href="{{ path('post_new') }}">Créer un post</a>
                {% if app.user %}
                    <span>Connecté: {{ app.user.userIdentifier }}</span>
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </nav>
        </header>

        <main>
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash {{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer>
            <p>Projet Symfony - Examen Final</p>
        </footer>

        <script src="/assets/js/app.js"></script>
    </body>
</html>

