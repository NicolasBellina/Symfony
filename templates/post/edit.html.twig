{% extends 'base.html.twig' %}

{% block title %}Modifier un post — Symphony{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Modifier le post</h1>
        <p>Mettez à jour le titre ou le contenu de votre publication.</p>
    </div>

    <div class="card card-form">
        {{ form_start(form, { attr: { class: 'card-form' } }) }}
            {{ form_row(form.title) }}
            {{ form_row(form.content) }}
            {{ form_row(form.save, { label: 'Enregistrer' }) }}
        {{ form_end(form) }}
    </div>

    <p class="auth-footer">
        <a href="{{ path('home') }}">← Retour à mes posts</a>
    </p>
{% endblock %}
