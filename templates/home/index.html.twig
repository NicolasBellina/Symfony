{% extends 'base.html.twig' %}

{% block title %}Accueil — Symphony{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Mes posts</h1>
        <p>Retrouvez et gérez vos publications.</p>
    </div>

    <div class="page-actions">
        <span></span>
        <a href="{{ path('post_new') }}" class="btn btn-primary">+ Nouveau post</a>
    </div>

    {% if posts is empty %}
        <div class="empty-state">
            <div class="empty-state__icon">📝</div>
            <h2>Aucun post pour le moment</h2>
            <p>Créez votre première publication !</p>
            <a href="{{ path('post_new') }}" class="btn btn-primary">Créer un post</a>
        </div>
    {% else %}
        <div class="posts-grid">
            {% for post in posts %}
                <article class="post-card">
                    <div class="post-card__header">
                        <h2 class="post-card__title">{{ post.title }}</h2>
                        <time class="post-card__date">{{ post.createdAt|date('d/m/Y · H:i') }}</time>
                    </div>
                    <p class="post-card__content">{{ post.content|nl2br }}</p>
                    <div class="post-card__actions">
                        <a href="{{ path('post_edit', { id: post.id }) }}" class="btn btn-outline">Modifier</a>
                        <form method="post" action="{{ path('post_delete', { id: post.id }) }}"
                              onsubmit="return confirm('Supprimer ce post ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                            <button type="submit" class="btn btn-ghost">Supprimer</button>
                        </form>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
